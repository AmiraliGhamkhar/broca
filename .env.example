APP_NAME="Broca | بروکا"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC

# Broca domain settings (timestamps stay UTC; display converts)
BROCA_DISPLAY_TIMEZONE=Asia/Tehran
BROCA_VIDEO_COMPLETION_THRESHOLD=70
BROCA_CURRENCY=IRR
BROCA_CURRENCY_DISPLAY=toman
BROCA_TERMS_VERSION=v1-placeholder
BROCA_PRIVACY_VERSION=v1-placeholder
BROCA_MEDICAL_DISCLAIMER_VERSION=v1-placeholder
# Keep checkout disabled until launch gates and payment tests pass.
BROCA_CHECKOUT_ENABLED=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 is the shared/cPanel-hosting default; switch DB_CONNECTION to
# pgsql on a VPS if preferred (see DECISIONS.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=broca
DB_USERNAME=broca
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Mark the session cookie Secure. Leave empty to auto-follow APP_FORCE_HTTPS.
SESSION_SECURE_COOKIE=
# Comma-separated reverse-proxy IPs (or *) when TLS terminates at a proxy
# (cPanel/shared hosting). Empty = no trusted proxies (direct serving).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payments via shetabit/payment. Amounts are stored in RIAL (integer).
# ZARINPAL_SANDBOX=true routes purchases to the sandbox endpoints.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL="${APP_URL}/payments/zarinpal/callback"

# Zibal (secondary driver, wired but not routed yet — see DECISIONS.md)
ZIBAL_MERCHANT_ID=
ZIBAL_CALLBACK_URL="${APP_URL}/payments/zibal/callback"

# Private notes/media storage and provider-neutral playback references.
PRIVATE_FILESYSTEM_DISK=private
VIDEO_PROVIDER=placeholder
VIDEO_PROVIDER_ENDPOINT=
VIDEO_PROVIDER_SIGNING_SECRET=
# Comma-separated allowed origins for externally hosted video playback URLs.
BROCA_EXTERNAL_VIDEO_ORIGINS=

# Telegram admin bot (webhook-driven). Restrict access to a short whitelist of
# Telegram numeric user IDs, comma-separated.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"
