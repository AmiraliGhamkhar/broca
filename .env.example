APP_NAME="Broca | بروکا"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=UTC
BROCA_DISPLAY_TIMEZONE=Asia/Tehran
BROCA_VIDEO_COMPLETION_THRESHOLD=70
BROCA_CURRENCY=IRR
BROCA_CURRENCY_DISPLAY=toman

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=broca
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Private notes/media storage and provider-neutral playback references.
PRIVATE_FILESYSTEM_DISK=private
VIDEO_PROVIDER=placeholder
VIDEO_PROVIDER_ENDPOINT=
VIDEO_PROVIDER_SIGNING_SECRET=

# Payment settings are intentionally empty until gateway credentials are supplied.
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
BROCA_TERMS_VERSION=v1-placeholder
BROCA_PRIVACY_VERSION=v1-placeholder
BROCA_MEDICAL_DISCLAIMER_VERSION=v1-placeholder

# Payments (sandbox by default; never commit real credentials)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8000/payments/zarinpal/callback

# Provider-neutral video delivery
VIDEO_PROVIDER=placeholder
VIDEO_PROVIDER_ENDPOINT=
VIDEO_PROVIDER_SIGNING_SECRET=
PRIVATE_FILESYSTEM_DISK=private

# ZarinPal payment gateway
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8000/payments/zarinpal/callback
